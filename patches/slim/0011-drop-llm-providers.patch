-const onContentBlockDelta = Effect.fn("AnthropicMessages.onContentBlockDelta")(function* (
-  state: ParserState,
-  event: AnthropicEvent,
-) {
-  const delta = event.delta
-
-  if (delta?.type === "text_delta" && delta.text) {
