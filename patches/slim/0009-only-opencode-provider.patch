-  const processedApprovalIds = new Set<string>()
-
-  for (const { role, content } of prompt) {
-    switch (role) {
-      case "system": {
-        switch (systemMessageMode) {
-          case "system": {
-            input.push({ role: "system", content })
-            break
-          }
-          case "developer": {
-            input.push({ role: "developer", content })
-            break
-          }
-          case "remove": {
-            warnings.push({
-              type: "other",
