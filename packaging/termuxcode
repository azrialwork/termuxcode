#!/data/data/com.termux/files/usr/bin/sh
set -eu

: "${PREFIX:=/data/data/com.termux/files/usr}"
LIBDIR="$PREFIX/lib/termuxcode"

export OPENTUI_LIB_PATH="$LIBDIR/libopentui.so"
export BUN_PTY_LIB="$LIBDIR/librust_pty.so"
export OPENCODE_DISABLE_FFF=1
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER=1

# Termux targets SDK 28, so Android's seccomp policy traps close_range with
# SIGSYS and Bun dies on startup. The shim emulates that one call.
COMPAT_LIB="$LIBDIR/libtermuxcode-compat.so"
LD_PRELOAD="$COMPAT_LIB${LD_PRELOAD:+:$LD_PRELOAD}"
export LD_PRELOAD

# Optional full state isolation for debugging: point every XDG location at a
# private root so a test run cannot read or migrate the real opencode state.
if [ -n "${TERMUXCODE_HOME:-}" ]; then
  mkdir -p "$TERMUXCODE_HOME/config" "$TERMUXCODE_HOME/data" \
    "$TERMUXCODE_HOME/cache" "$TERMUXCODE_HOME/state" "$TERMUXCODE_HOME/tmp"
  export XDG_CONFIG_HOME="$TERMUXCODE_HOME/config"
  export XDG_DATA_HOME="$TERMUXCODE_HOME/data"
  export XDG_CACHE_HOME="$TERMUXCODE_HOME/cache"
  export XDG_STATE_HOME="$TERMUXCODE_HOME/state"
  export TMPDIR="$TERMUXCODE_HOME/tmp"
fi

for file in "$LIBDIR/termuxcode" "$OPENTUI_LIB_PATH" "$BUN_PTY_LIB" "$COMPAT_LIB"; do
  if [ ! -e "$file" ]; then
    echo "termuxcode: missing $file" >&2
    echo "termuxcode: reinstall with 'pkg install --reinstall termuxcode'" >&2
    exit 1
  fi
done

case "${1:-}" in
  upgrade|uninstall)
    echo "termuxcode: '$1' is managed by Termux." >&2
    echo "termuxcode: use 'pkg upgrade termuxcode' or 'pkg uninstall termuxcode'." >&2
    exit 1
    ;;
esac

exec "$LIBDIR/termuxcode" "$@"
