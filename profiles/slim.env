# Build profile: slim
#
# Trimmed build for daily use: fewer bundled features, same bionic port.
# Nothing is trimmed until the baseline in docs/benchmarks.md existed.
PROFILE=slim
PACKAGE_VERSION_SUFFIX=+slim1

# Enforced by scripts/measure.sh --budget profiles/slim.env. Leave empty to
# skip a check. Fill these in with the first slim build, then tighten them as
# the profile improves; an empty budget is a silent regression.
BUDGET_PACKAGE_MB=
BUDGET_RSS_MB=
BUDGET_PSS_MB=
BUDGET_STARTUP_MS=
