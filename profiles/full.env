# Build profile: full
#
# Everything upstream ships, ported to bionic. This is the compatibility
# baseline that the slim profile is measured against.
PROFILE=full
PACKAGE_VERSION_SUFFIX=

# No budgets: full tracks upstream, so its size only moves when upstream does.
BUDGET_PACKAGE_MB=
BUDGET_RSS_MB=
BUDGET_PSS_MB=
BUDGET_STARTUP_MS=
